# scratch is presumed deletable and never committed
/scratch/*
!/scratch/.gitkeep

# results are regenerated by runs; keep the dir, not its contents
/results/*
!/results/.gitkeep

# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# os
.DS_Store
